<div class="mb-8">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">Dashboard</h1>
  <p class="mt-2 text-sm text-slate-600">
    Bienvenido al sistema de auditoría ERP Neodata. Selecciona una acción para comenzar.
  </p>
</div>

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  <!-- Prepare Data Card -->
  <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-slate-200 transition-all hover:shadow-md hover:border-slate-300 group">
    <div class="p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-blue-50 rounded-lg p-3 group-hover:bg-blue-100 transition-colors">
          <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
        </div>
        <div class="ml-4">
          <h3 class="text-lg font-medium text-slate-900">Pre procesar datos</h3>
          <p class="text-sm text-slate-500 mt-1">Importar archivos CSV requeridos.</p>
        </div>
      </div>
      <div class="mt-6">
        <a href="#" class="w-full flex justify-center items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
          Iniciar importación
        </a>
      </div>
    </div>
  </div>

  <!-- Consult Predial Card -->
  <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-slate-200 transition-all hover:shadow-md hover:border-slate-300 group">
    <div class="p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-emerald-50 rounded-lg p-3 group-hover:bg-emerald-100 transition-colors">
          <svg class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
          </svg>
        </div>
        <div class="ml-4">
          <h3 class="text-lg font-medium text-slate-900">Consultar Datos Predial</h3>
          <p class="text-sm text-slate-500 mt-1">Ver padrón oficial importado.</p>
        </div>
      </div>
      <div class="mt-6">
        <%= link_to "Ver registros", predial_ags_jms_path, class: "w-full flex justify-center items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
      </div>
    </div>
  </div>
</div>
