<div class="mb-8">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">Dashboard de Auditoría: Predial vs ERP Neodata</h1>
  <p class="mt-2 text-sm text-slate-600">
    Importa los archivos <code class="font-mono text-xs bg-slate-200 px-1.5 py-0.5 rounded">.csv</code> desde cualquier carpeta local y consulta los padrones procesados renglón por renglón.
  </p>
</div>

<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
  <!-- Tarjeta 1: Padrón Predial (Autoridad) -->
  <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-slate-200 flex flex-col justify-between transition-all hover:shadow-md">
    <div class="p-6">
      <div class="flex items-start justify-between">
        <div class="flex items-center">
          <div class="flex-shrink-0 bg-emerald-50 rounded-lg p-3">
            <svg class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
            </svg>
          </div>
          <div class="ml-4">
            <h2 class="text-lg font-semibold text-slate-900">1. Padrón Predial (Autoridad)</h2>
            <p class="text-sm text-slate-500 mt-0.5">Archivo CSV entregado por la autoridad municipal.</p>
          </div>
        </div>
        <span class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
          <%= @predial_count %> registros
        </span>
      </div>

      <!-- Formulario de importación Predial -->
      <%= form_with url: import_predial_ags_jms_path, method: :post, multipart: true, data: { turbo: false }, class: "mt-6 space-y-4 bg-slate-50 p-4 rounded-lg border border-slate-200" do %>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wide text-slate-700 mb-1.5">
            Seleccionar archivo .csv desde cualquier carpeta
          </label>
          <%= file_field_tag :file,
                accept: ".csv,text/csv",
                class: "block w-full text-sm text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-emerald-600 file:text-white hover:file:bg-emerald-700 cursor-pointer" %>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">
            O especificar ruta local del archivo CSV en el servidor/equipo:
          </label>
          <%= text_field_tag :file_path,
                "storage/DCC-PREDIAL-2026.csv",
                placeholder: "Ej. storage/DCC-PREDIAL-2026.csv o /home/usuario/documentos/predial.csv",
                class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
        </div>

        <div class="flex items-center justify-between pt-1">
          <label class="inline-flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
            <%= check_box_tag :replace_existing, "1", false, class: "rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" %>
            <span>Reemplazar registros existentes al importar</span>
          </label>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          <%= submit_tag "Importar CSV Predial",
                class: "w-full inline-flex justify-center items-center px-4 py-2.5 border border-transparent shadow-sm text-sm font-semibold rounded-md text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 cursor-pointer transition-colors" %>

          <%= link_to "Ver registros Predial (#{@predial_count})",
                predial_ags_jms_path,
                class: "w-full inline-flex justify-center items-center px-4 py-2.5 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Tarjeta 2: Reporte ERP Neodata -->
  <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-slate-200 flex flex-col justify-between transition-all hover:shadow-md">
    <div class="p-6">
      <div class="flex items-start justify-between">
        <div class="flex items-center">
          <div class="flex-shrink-0 bg-indigo-50 rounded-lg p-3">
            <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
            </svg>
          </div>
          <div class="ml-4">
            <h2 class="text-lg font-semibold text-slate-900">2. Reporte ERP Neodata</h2>
            <p class="text-sm text-slate-500 mt-0.5">Archivo CSV exportado del sistema ERP Neodata.</p>
          </div>
        </div>
        <span class="inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-inset ring-indigo-600/20">
          <%= @neodata_count %> registros
        </span>
      </div>

      <!-- Formulario de importación Neodata -->
      <%= form_with url: import_neodata_records_path, method: :post, multipart: true, data: { turbo: false }, class: "mt-6 space-y-4 bg-slate-50 p-4 rounded-lg border border-slate-200" do %>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wide text-slate-700 mb-1.5">
            Seleccionar archivo .csv desde cualquier carpeta
          </label>
          <%= file_field_tag :file,
                accept: ".csv,text/csv",
                class: "block w-full text-sm text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-600 file:text-white hover:file:bg-indigo-700 cursor-pointer" %>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">
            O especificar ruta local del archivo CSV en el servidor/equipo:
          </label>
          <%= text_field_tag :file_path,
                "storage/concentrado-gsc.csv",
                placeholder: "Ej. storage/concentrado-gsc.csv o /home/usuario/documentos/neodata.csv",
                class: "block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        </div>

        <div class="flex items-center justify-between pt-1">
          <label class="inline-flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
            <%= check_box_tag :replace_existing, "1", false, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
            <span>Reemplazar registros existentes al importar</span>
          </label>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          <%= submit_tag "Importar CSV Neodata",
                class: "w-full inline-flex justify-center items-center px-4 py-2.5 border border-transparent shadow-sm text-sm font-semibold rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer transition-colors" %>

          <%= link_to "Ver registros Neodata (#{@neodata_count})",
                neodata_records_path,
                class: "w-full inline-flex justify-center items-center px-4 py-2.5 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Barra resumen de incidencias / duplicados capturados durante la validación -->
<div class="mt-8 bg-white shadow-sm rounded-xl border border-slate-200 p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div class="flex items-center gap-3">
    <div class="flex-shrink-0 bg-amber-50 rounded-lg p-2.5">
      <svg class="h-5 w-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
      </svg>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-slate-900">Registros Duplicados o con Incidencias de Validación</h3>
      <p class="text-xs text-slate-500">
        Renglones detectados con índice repetido o datos incompletos al importar cualquiera de los dos archivos CSV:
        <span class="font-semibold text-slate-700"><%= @duplicates_count %></span>.
      </p>
    </div>
  </div>
  <div>
    <%= link_to "Ver duplicados e incidencias",
          repeated_exemptions_path,
          class: "inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" %>
  </div>
</div>
